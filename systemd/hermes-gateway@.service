# Generic Hermes Agent Gateway template (systemd user unit, host install).
# One template serves every profile. Enable one instance per profile:
#   systemctl --user enable --now 'hermes-gateway@<profile>.service'
# <profile> = "default" (root install at ~/.hermes) or a named profile
# (researcher, jseeker, ...). The launcher scripts/hermes-gateway-run sets
# HERMES_HOME and --profile per instance. %h expands to the user's home dir;
# adjust the node path in PATH if you don't use nvm.

[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/Hermes/scripts/hermes-gateway-run %i
Environment="PATH=%h/.hermes/hermes-agent/venv/bin:%h/.hermes/hermes-agent/node_modules/.bin:%h/.nvm/versions/node/v24.11.1/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=%h/.hermes/hermes-agent/venv"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-%h/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
