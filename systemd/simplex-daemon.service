# SimpleX Chat daemon — systemd user unit backing the Hermes gateway bot.
# Copy to ~/.config/systemd/user/simplex-daemon.service and enable:
#   systemctl --user daemon-reload
#   systemctl --user enable --now simplex-daemon.service
# Requires the simplex-chat CLI at ~/bin/simplex-chat (see docs/simplex.md).
# %h expands to the user's home dir.

[Unit]
Description=SimpleX Chat Daemon (Hermes Gateway Bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/bin/simplex-chat -p 5225 --files-folder %h/.hermes/cache/documents --temp-folder %h/.hermes/cache/documents/.simplex-tmp --auto-accept-files 50000000
Restart=always
RestartSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
