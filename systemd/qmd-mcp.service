# QMD MCP server — systemd user unit (host install). Local on-device search
# over the Obsidian vault, served to Hermes as an HTTP MCP on port 8181.
# Copy to ~/.config/systemd/user/qmd-mcp.service and enable:
#   systemctl --user daemon-reload
#   systemctl --user enable --now qmd-mcp.service
# %h expands to the user's home dir. Requires the qmd binary installed via nvm
# node (npm install -g @tobilu/qmd). See docs/qmd.md and memory-bank/qmd-setup.md.
# GPU tuning (Quadro M2000M 4GB): smaller rerank contexts + limited embed
# parallelism prevent Vulkan OOM; LLAMA_LOG_LEVEL=error quiets llama.cpp.

[Unit]
Description=QMD MCP server (HTTP on port 8181)
After=network.target
Wants=network.target

[Service]
Type=simple
Environment=QMD_RERANK_CONTEXT_SIZE=1024
Environment=QMD_EMBED_PARALLELISM=2
Environment=LLAMA_LOG_LEVEL=error
Environment=PATH=%h/.nvm/versions/node/v24.11.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v24.11.1/bin/qmd mcp --http --port 8181
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
