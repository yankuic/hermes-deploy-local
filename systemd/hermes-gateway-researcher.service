# Hermes Agent Gateway (researcher profile) — systemd user unit (host install).
# Copy to ~/.config/systemd/user/hermes-gateway-researcher.service and enable:
#   systemctl --user daemon-reload
#   systemctl --user enable --now hermes-gateway-researcher.service
# %h expands to the user's home dir; adjust the node path below if you
# don't use nvm or your node lives elsewhere. The researcher API server
# listens on port 8643 (see profiles/researcher/config.yaml -> platforms).

[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main --profile researcher gateway run
WorkingDirectory=%h/.hermes/profiles/researcher
Environment="PATH=%h/.hermes/hermes-agent/venv/bin:%h/.hermes/hermes-agent/node_modules/.bin:%h/.nvm/versions/node/v24.11.1/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=%h/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=%h/.hermes/profiles/researcher"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-%h/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
