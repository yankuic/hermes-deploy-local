# Hermes Agent host-install environment template.
# This file documents every environment variable used by the deployment.
# On the target host, create the real file at ~/.hermes/.env and fill in
# the <PLACEHOLDER> values. NEVER commit the real .env.

# === Terminal (docker sandbox) ===
TERMINAL_ENV=docker
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300
# Run sandbox containers with the host user's UID/GID instead of a fixed user:
TERMINAL_DOCKER_RUN_AS_HOST_USER=true

# === API server (local HTTP API) ===
API_SERVER_ENABLED=true
# Generate with: openssl rand -hex 32
API_SERVER_KEY=<API_SERVER_KEY>

# === SimpleX gateway ===
SIMPLEX_WS_URL=ws://127.0.0.1:5225
SIMPLEX_HOME_CHANNEL=<SIMPLEX_CONTACT_DISPLAY_NAME>
SIMPLEX_ALLOW_ALL_USERS=true
SIMPLEX_AUTO_ACCEPT=true

# === Obsidian (optional; forwarded into the sandbox) ===
OBSIDIAN_URL=<OBSIDIAN_URL>
OBSIDIAN_API_KEY=<OBSIDIAN_API_KEY>
OBSIDIAN_VAULT_PATH=<VAULT_PATH>

# === Web search ===
SEARXNG_URL=http://localhost:8088/

# === Optional / debug (defaults are fine if absent) ===
# BROWSERBASE_ADVANCED_STEALTH=
# BROWSERBASE_PROXIES=
# BROWSER_INACTIVITY_TIMEOUT=
# BROWSER_SESSION_TIMEOUT=
# HERMES_UID=
# HERMES_GID=
# IMAGE_TOOLS_DEBUG=
# MOA_TOOLS_DEBUG=
# TERMINAL_MODAL_IMAGE=
# VISION_TOOLS_DEBUG=
# WEB_TOOLS_DEBUG=
